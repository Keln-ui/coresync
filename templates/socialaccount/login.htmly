{% extends "base.html" %}

{% block content %}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height:80vh;">

    <div class="card shadow-lg border-0 rounded-4 p-5 text-center"
         style="max-width:450px; width:100%;">

        <div class="mb-4">
            <i class="bi bi-google fs-1 text-danger"></i>
        </div>

        <h2 class="fw-bold mb-3">
            Sign in with Google
        </h2>

        <p class="text-muted mb-4">
            Continue to Revise using your Google account.
            Your account will be securely connected.
        </p>


        <form method="post">

            {% csrf_token %}

            <button type="submit"
                    class="btn btn-danger btn-lg w-100 rounded-pill">

                <i class="bi bi-google me-2"></i>
                Continue with Google

            </button>

        </form>


        <a href="{% url 'account_login' %}"
           class="btn btn-outline-secondary mt-3 rounded-pill">

            Back to login

        </a>

    </div>

</div>

{% endblock %}

